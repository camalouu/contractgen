+bool immediate_is_negative(const decoded_insn& insn)
+{
+  if (!insn.imm) return false;
+  unsigned sign_bit;
+  switch (insn.format) {
+    case format_t::i: case format_t::s: sign_bit = 11; break;
+    case format_t::b: sign_bit = 12; break;
+    case format_t::j: sign_bit = 20; break;
+    case format_t::u: sign_bit = 31; break;
+    case format_t::r: return false; // Shift amounts are unsigned, not immediates here.
+  }
+  return (*insn.imm & (uint32_t(1) << sign_bit)) != 0;
 }
 
